# Copy this file to `.env` (already gitignored — never commit real secrets)
# and fill in real values for local development / ad-hoc test scripts.
#
# For running the Streamlit app itself, prefer
# deploy/heroku/.streamlit/secrets.toml (see secrets.toml.example) —
# main.py loads this .env too so either works, but secrets.toml is what
# `st.secrets` reads and is the convention the rest of the app follows.

# MongoDB connection string (same one used by pages/google_earth.py for
# the r1_data school-directory collection, and by the planned camera
# asset-intake workflow for camera_chart / camera_assets).
# The database name is parsed from the URI path, e.g. ".../app_data?...".
MONGODB_URI=
