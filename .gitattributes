# Normalize all text files to LF in the repo — CRLF in Procfile/runtime.txt
# breaks the Heroku build/run.
* text=auto eol=lf

# Shell scripts must keep LF endings regardless of local git/OS settings —
# a CRLF shebang line breaks execution on Heroku's Linux build (bin/post_compile).
*.sh text eol=lf
bin/* text eol=lf
